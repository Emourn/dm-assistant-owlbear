{
    "masteryProperties": [
        {
            "name": "Cleave",
            "description": "If you hit a creature with a melee attack roll, you can make a second attack against another creature within 5 ft that is also within reach. (1/turn, no ability mod to damage unless negative)."
        },
        {
            "name": "Graze",
            "description": "If your attack roll misses a creature, you deal damage equal to the ability modifier used for the attack."
        },
        {
            "name": "Nick",
            "description": "The extra attack of the Light property can be made as part of the Attack action instead of as a Bonus Action. (1/turn)."
        },
        {
            "name": "Push",
            "description": "If you hit a creature, you can push it up to 10 feet straight away if it is Large or smaller."
        },
        {
            "name": "Sap",
            "description": "If you hit a creature, it has Disadvantage on its next attack roll before the start of your next turn."
        },
        {
            "name": "Slow",
            "description": "If you hit a creature and deal damage, reduce its Speed by 10 feet until the start of your next turn."
        },
        {
            "name": "Topple",
            "description": "If you hit a creature, force a Con save (DC 8 + mod + Prof) or it has the Prone condition."
        },
        {
            "name": "Vex",
            "description": "If you hit a creature and deal damage, you have Advantage on your next attack roll against it before the end of your next turn."
        }
    ],
